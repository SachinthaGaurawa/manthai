# House of MANTHAI · atelier computer only (scripts/encoder). Copy to .env.local.
# .env.local is git-ignored and never deployed. Never send these values to anyone,
# including a chip supplier, and never paste them into a chat.

# The House domain printed on every chip. Must be https and the domain only.
# A vercel.app or local address is refused (test chips: --allow-test-domain).
SDM_BASE_URL=https://www.your-house-domain.com

# The same 32-hex value you set in Vercel as NFC_SDM_MAC_KEY.
NFC_SDM_MAC_KEY=

# Only for --production-lock: a second 32-hex key, generated on this computer
# (openssl rand -hex 16). Keep a sealed offline copy. It is never set in Vercel.
ATELIER_CHIP_MASTER_KEY=
